NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Meta app ID for the Instagram Stories share deep link
# (instagram-stories://share?source_application=<id>). This is a public
# identifier, not a secret -- the app secret is never used by this
# feature (no OAuth/server call involved, just a URL scheme + clipboard
# write) and must never go in this file or anywhere client-side.
NEXT_PUBLIC_INSTAGRAM_APP_ID=
