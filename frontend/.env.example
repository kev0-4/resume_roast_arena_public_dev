NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Meta app ID for the Instagram Stories share deep link
# (instagram-stories://share?source_application=<id>). This is a public
# identifier, not a secret -- the app secret is never used by this
# feature (no OAuth/server call involved, just a URL scheme + clipboard
# write) and must never go in this file or anywhere client-side.
NEXT_PUBLIC_INSTAGRAM_APP_ID=

# Firebase Web App config (Firebase Console -> Project Settings -> General
# -> Your apps -> Web app). All of these are meant to be public -- this is
# not a secret the way backend/src/services/service-account.json is.
# Must point at the SAME Firebase project as that service account, or
# every ID token this issues will fail to verify on the backend.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
