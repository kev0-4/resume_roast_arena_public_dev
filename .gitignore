# Environment files
.env
.env.*
*.env

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Service account credentials (never commit these!)
**/service-account.json
service-account*.json
**/service-account*.json

# Local deployment secrets/manifests (real Azure/GHCR credentials -- never commit)
/deploy/
# Real individuals' self-published CVs used for scoring evaluation.
# PII is stripped, but the bullet text stays close to the source and would
# be reverse-searchable in a public repo. Local-only on purpose --
# quality-scoring-eval/run_shipped_eval.py runs without it.
quality-scoring-eval/real_resumes.py
quality-scoring-eval/real_eval_results*.json
quality-scoring-eval/shipped_eval_results*.json
quality-scoring-eval/__pycache__/

# scripts/interview_smoke_test/: an on-demand, real-money integration test
# (see scripts/interview_smoke_test/run.py's docstring). Its cached audio
# fixtures are synthesized/recorded speech -- never committed, whether
# TTS output or a real recorded voice, and regenerated locally on demand.
scripts/interview_smoke_test/.cache/
scripts/interview_smoke_test/**/*.mp3
scripts/interview_smoke_test/**/*.wav
scripts/interview_smoke_test/**/*.pcm16

# Structured telemetry now goes to stdout (Log Analytics), never to a file.
# These were committed by the old file-writing emit_event and reached 513KB.
log_entry.json
**/log_entry.json
